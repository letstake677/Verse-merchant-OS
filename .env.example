# ==============================================================================
# VERSE MERCHANT OS — PRODUCTION ENVIRONMENT CONTRACT (Phase 6N)
# ==============================================================================
#
# SECURITY RULES:
# 1. Never expose server-only secrets (e.g. MONGODB_URI, SESSION_SECRET).
# 2. Never commit actual production credentials or private keys to source control.
# 3. Production fails closed if critical secrets (MONGODB_URI, SESSION_SECRET) are missing.
# 4. In production, SESSION_SECRET must be at least 32 cryptographically random characters.
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SECRETS (Required in Production)
# ------------------------------------------------------------------------------

# MONGODB_URI: MongoDB Atlas connection string with authenticated credentials.
# Must point to your secure production cluster.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=""

# MONGODB_DB_NAME: MongoDB database name.
# Optional. Defaults to "verse-merchant-os" if left blank.
MONGODB_DB_NAME="verse-merchant-os"

# SESSION_SECRET: High-entropy secret key used to HMAC-sign and verify SIWE session cookies.
# Must be at least 32 characters in production. (e.g. openssl rand -base64 32)
SESSION_SECRET=""

# ------------------------------------------------------------------------------
# 2. APPLICATION & HOSTING CONFIGURATION
# ------------------------------------------------------------------------------

# APP_URL: Canonical public URL where this applet is hosted (e.g. https://your-domain.com).
# In Google AI Studio / Cloud Run, this is automatically provided by the runtime.
APP_URL=""

# ------------------------------------------------------------------------------
# 3. WEB3 & BLOCKCHAIN RPC CONFIGURATION
# ------------------------------------------------------------------------------

# POLYGON_RPC_URL: Server-side Polygon Mainnet RPC URL.
# Optional. Defaults to "https://polygon-rpc.com".
# For high-throughput production, configure an authenticated RPC endpoint (Alchemy, Infura, QuickNode).
POLYGON_RPC_URL=""

# POLYGON_AMOY_RPC_URL: Server-side Polygon Amoy Testnet RPC URL.
# Optional. Defaults to "https://rpc-amoy.polygon.technology".
POLYGON_AMOY_RPC_URL=""

# Reown / AppKit / WalletConnect project ID.
# Client-side identifier for wallet connection modals.
NEXT_PUBLIC_REOWN_PROJECT_ID=""
NEXT_REOWN_PROJECT_ID=""
